# WeKnora Sandbox Image
# Pre-built environment for executing agent skill scripts in Docker sandbox
# Multi-stage build, minimal dependencies
#
# Two targets ship from this file:
#   runtime (default) - the plain environment. Used by the Docker backend and
#                       as the base image of E2B templates, whose builder
#                       injects its own envd.
#   cube              - the same environment plus Cube's envd daemon. Cube
#                       builds templates straight from the image and probes
#                       :49983/health, so an image without envd can only ever
#                       fail. See docs/sandbox-cluster.md.

# Stage 1: Get Node.js binaries
FROM node:20-slim AS node-base

# Stage 2: Runtime image
FROM python:3.11-slim AS runtime

# Copy Node.js from node image (avoids NodeSource install overhead)
COPY --from=node-base /usr/local/bin/node /usr/local/bin/
COPY --from=node-base /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Python package manager: uv (fast pip replacement). Preinstalled because each
# skill gets its own venv at install time, and building that from a cold pip is
# what dominates an install's wall clock.
COPY --from=ghcr.io/astral-sh/uv:0.12.4 /uv /usr/local/bin/uv
RUN ln -s /usr/local/bin/uv /usr/local/bin/uvx

# Node package manager: pnpm
RUN npm install -g pnpm

# Install minimal CLI tools (bash/grep/sed/coreutils/findutils already in slim
# image). `file` is not in slim; models reach for it after a script-type error.
# curl is not optional: the sandbox connectivity check probes egress with it,
# and skills that fetch a URL expect it to be there. The compression tools are
# here because skill bundles and their assets arrive archived.
#
# libicu-dev is a Debian virtual package that pulls the runtime ICU library
# (libicuNN matching the base image's Debian release). It is required by
# officecli, which is a .NET self-contained binary — its globalization
# stack crashes at startup with "Couldn't find a valid ICU package" without
# libicu present.
RUN apt-get update && apt-get install -y --no-install-recommends \
    jq \
    curl \
    ca-certificates \
    file \
    zip \
    unzip \
    bzip2 \
    xz-utils \
    zstd \
    libicu-dev \
    # Document format conversion (Markdown <-> DOCX/PDF/HTML/...). Models reach
    # for `pandoc` when scripts need to produce Word/PDF from Markdown or
    # ingest formats DocReader does not handle directly. Available from the
    # base image's Debian repo, no extra apt source needed.
    pandoc \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# Note: Current preloaded skills only use Python stdlib
# Add packages here when skills actually need them:

# Create non-root user (UID 1000) for sandbox execution. The account is named
# "user" because that is the account name E2B templates are expected to expose
# and the one WeKnora names when running scripts and file operations against an
# E2B-protocol backend; the Docker backend addresses it numerically as
# 1000:1000, so both paths land on the same account.
RUN groupadd -g 1000 user && \
    useradd -u 1000 -g user -m -s /bin/bash user

# Pre-create the two directories every backend writes to and hand them to the
# sandbox account. WeKnora otherwise has to create and chown them as root on
# each execution, which needs capabilities a hardened container should not
# have to keep.
RUN mkdir -p /workspace/input /workspace/output && \
    chown -R user:user /workspace

# Pre-install Office document generation libraries into the system Python so
# every session sandbox (Docker backend) ships with them. Skills that build
# their own venv at install time can still fall back to `import docx` from the
# system interpreter.
#
#   python-docx        - .docx generation (Word)
#   python-pptx        - .pptx generation (PowerPoint)
#   openpyxl           - .xlsx read/write (Excel)
#   Pillow             - image handling for slides/embeds
#   docxtpl            - Jinja2-style .docx template rendering
#   matplotlib         - chart generation (embedded as images)
#   pandas             - tabular data wrangling feeding the above
#
# Pin majors so future upstream breakage does not silently break skill scripts.
RUN uv pip install --system --no-cache \
    "python-docx>=1.1,<2" \
    "python-pptx>=0.6,<1" \
    "openpyxl>=3.1,<4" \
    "Pillow>=10,<12" \
    "docxtpl>=0.18,<1" \
    "matplotlib>=3.8,<4" \
    "pandas>=2.2,<3" && \
    python -c "import docx, pptx, openpyxl, PIL, docxtpl, matplotlib, pandas; print('office-doc-gen family libs (used by office-template-fill + document-analyzer):', docx.__version__, pptx.__version__, openpyxl.__version__, PIL.__version__, docxtpl.__version__, matplotlib.__version__, pandas.__version__)"

# Install officecli (officecli.ai CLI): single static binary for AI-driven
# .docx/.xlsx/.pptx creation / inspection / editing. Sandbox skills call it as
# `officecli <file> ...` — no Office install needed. Installed to
# /usr/local/bin so it's on PATH for both the build (root) and the runtime
# `user` account; USER user is set further down.
#
# Mirror primary (d.officecli.ai) with GitHub fallback so the build is
# reproducible whether or not the mirror is reachable. Version is pinned
# to the resolved tag at build time via the immutable
# /releases/download/vX.Y.Z/ path (the install.sh warns that the mutable
# /releases/latest/download/ can serve a stale binary for up to 4h after
# a release due to CDN caching).
RUN set -eux; \
    if [ ! -x /usr/local/bin/officecli ]; then \
        ARCH=$(uname -m); \
        case "$ARCH" in \
            x86_64)        ASSET=officecli-linux-x64 ;; \
            aarch64|arm64) ASSET=officecli-linux-arm64 ;; \
            *) echo "officecli: unsupported arch $ARCH" >&2; exit 1 ;; \
        esac; \
        VERSION=$(curl -fsSL --max-time 30 -o /dev/null -w '%{url_effective}' \
                    https://d.officecli.ai/releases/latest \
                    | sed 's#.*/tag/v##'); \
        if [ -z "$VERSION" ]; then \
            echo "officecli: could not resolve latest version" >&2; exit 1; \
        fi; \
        URL_BASE="https://d.officecli.ai/releases/download/v${VERSION}"; \
        if ! curl -fsSL --max-time 300 --connect-timeout 10 \
                "${URL_BASE}/${ASSET}" -o /usr/local/bin/officecli; then \
            URL_BASE="https://github.com/iOfficeAI/OfficeCLI/releases/download/v${VERSION}"; \
            curl -fsSL --max-time 300 "${URL_BASE}/${ASSET}" -o /usr/local/bin/officecli; \
        fi; \
        chmod 0755 /usr/local/bin/officecli; \
        officecli --version; \
    fi

WORKDIR /workspace
USER user

# Stage 3: Cube template image
#
# envd is what Cube talks to for everything — the readiness probe that decides
# whether a template build succeeds, plus every later exec and file call. It
# runs as root and drops to the account named in each request, which is why
# this variant does not keep the runtime's USER user.
#
# This target is linux/amd64 only: cubesandbox-base publishes no arm64 image,
# which matches Cube itself (PVM is x86_64-only).
FROM ghcr.io/tencentcloud/cubesandbox-base:2026.16 AS cube-base

FROM runtime AS cube

USER root
COPY --from=cube-base /usr/bin/envd /usr/bin/envd
COPY --from=cube-base /usr/local/bin/cube-entrypoint.sh /usr/local/bin/cube-entrypoint.sh

EXPOSE 49983
# The entrypoint backgrounds envd and then waits on it, since this image
# defines no CMD of its own.
ENTRYPOINT ["/usr/local/bin/cube-entrypoint.sh"]

# Stage 4: default target
#
# Docker builds the last stage when none is named, and that must stay the plain
# runtime: a bare `docker build -f docker/Dockerfile.sandbox .` is expected to
# produce the image the Docker backend runs, not the Cube variant.
FROM runtime AS sandbox
