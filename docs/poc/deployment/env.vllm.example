# =====================================================
# LuoSA 客户侧 vLLM 部署最小配置
# =====================================================

# ----- 镜像来源 -----
# 替换为你的实际前缀（GHCR 或 Docker Hub）
WEKNORA_IMAGE_PREFIX=ghcr.io/<your-github-owner>/
WEKNORA_VERSION=main

# ----- 暴露端口 -----
FRONTEND_PORT=80
APP_PORT=8080

# ----- LLM / vLLM 端点（管理员配置一次，普通用户零感知）-----
LLM_PROVIDER=openai                  # vLLM 兼容 OpenAI 协议
LLM_BASE_URL=http://<vllm-host>:8000/v1
LLM_MODEL_NAME=Qwen2.5-14B-Instruct
LLM_API_KEY=EMPTY                    # vLLM 默认不校验
LLM_CONTEXT_WINDOW=32768
LLM_MAX_TOKENS=4096

EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://<vllm-host>:8000/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

RERANK_PROVIDER=openai               # 如果 vLLM 没部署 rerank,可改成 disabled
RERANK_BASE_URL=http://<vllm-host>:8000/v1
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# ----- 后端基础 -----
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=luosa
DB_PASSWORD=change-me-strong-password
DB_DATABASE=luosa

# ----- 向量库（任选其一,默认 Qdrant）-----
VECTOR_STORE_TYPE=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6334
QDRANT_COLLECTION=luosa_embeddings

# ----- 对象存储（MinIO,S3 兼容）-----
STORAGE_TYPE=minio
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-strong-password
S3_BUCKET_NAME=luosa
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# ----- 沙箱（可选,默认启用）-----
SANDBOX_ENABLED=true
SANDBOX_IMAGE=${WEKNORA_IMAGE_PREFIX}weknora-sandbox:${WEKNORA_VERSION}

# ----- 鉴权（首次启动生成管理员账户）-----
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-strong-password
INITIAL_ADMIN_EMAIL=admin@example.com

# ----- 日志 -----
LOG_LEVEL=info
